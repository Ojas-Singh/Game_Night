{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "noEmit": true,
    "types": ["vite/client"],
    "paths": {
      "@shared/*": ["../../packages/shared/src/*"],
      "@cabo/*": ["../../packages/engine-cabo/src/*"],
      "@pairone/*": ["../../packages/engine-pairone/src/*"],
      "@seep/*": ["../../packages/engine-seep/src/*"]
    }
  },
  "include": ["src", "vite.config.ts"]
}
